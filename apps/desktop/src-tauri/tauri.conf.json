{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "0.5.0",
  "identifier": "co.lummina.strata",
  "build": {
    "beforeDevCommand": "vp dev --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "externalBin": ["bin/oracle-bridge"],
    "active": true,
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop database client",
    "longDescription": "A desktop database client for PostgreSQL, SQL Server, and Oracle.",
    "macOS": { "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
